# TC Grün-Weiss Heiligenwald – Serverregeln für Hostinger (LiteSpeed/Apache)

Options -Indexes
ServerSignature Off
DirectoryIndex index.html
AddType application/manifest+json .webmanifest
ErrorDocument 404 /404.html

<IfModule mod_rewrite.c>
RewriteEngine On

# Testadresse: Suchmaschinen und KI-Crawler aussperren (nur für diese Adresse)
RewriteCond %{HTTP_HOST} ^tch\.joshua-wurf\.de$ [NC]
RewriteRule .* - [E=TESTHOST:1]
RewriteCond %{HTTP_HOST} ^tch\.joshua-wurf\.de$ [NC]
RewriteRule ^robots\.txt$ /robots-test.txt [L]

# HTTPS erzwingen
RewriteCond %{HTTPS} !=on
RewriteCond %{HTTP:X-Forwarded-Proto} !=https
RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]

# www auf die Adresse ohne www leiten
RewriteCond %{HTTP_HOST} ^www\.(.+)$ [NC]
RewriteRule ^ https://%1%{REQUEST_URI} [L,R=301]

# /index.html gibt es nur als "/" (kein doppelter Inhalt)
RewriteCond %{THE_REQUEST} \s/index\.html[\s?]
RewriteRule ^index\.html$ / [R=301,L]

# Alte Adressen der bisherigen Seite auf die neuen Seiten leiten (301)
RewriteRule ^jugend/?$ /jugend.html [R=301,L]
RewriteRule ^damen/?$ /damen.html [R=301,L]
RewriteRule ^herren/?$ /herren.html [R=301,L]
RewriteRule ^mixed/?$ /mixed.html [R=301,L]
RewriteRule ^galerie/?$ /galerie.html [R=301,L]
RewriteRule ^aktuelles/?$ /aktuelles.html [R=301,L]
RewriteRule ^impressum/?$ /impressum.html [R=301,L]
RewriteRule ^datenschutz/?$ /datenschutz.html [R=301,L]
RewriteRule ^gastronomie/?$ /#gastro [NE,R=301,L]
RewriteRule ^vorstand/?$ /#vorstand [NE,R=301,L]
RewriteRule ^sponsoren/?$ /#sponsoren [NE,R=301,L]
RewriteRule ^(kontakt|mitgliedschaft)/?$ /#kontakt [NE,R=301,L]
</IfModule>

# Sicherheits-Header
<IfModule mod_headers.c>
Header always set Strict-Transport-Security "max-age=31536000"
Header always set X-Content-Type-Options "nosniff"
Header always set Referrer-Policy "strict-origin-when-cross-origin"
Header always set Permissions-Policy "camera=(), microphone=(), geolocation=(), payment=(), interest-cohort=()"
Header always set Cross-Origin-Opener-Policy "same-origin"
Header always set X-Robots-Tag "noindex, nofollow, noarchive" env=TESTHOST
Header always set Content-Security-Policy "default-src 'self'; img-src 'self' data:; style-src 'self' 'unsafe-inline'; script-src 'self'; font-src 'self'; connect-src 'self'; object-src 'none'; base-uri 'self'; form-action 'self'; frame-ancestors 'self' https://joshualudwig.de https://www.joshualudwig.de https://*.lovable.app https://*.lovableproject.com http://localhost:* http://127.0.0.1:*"
</IfModule>

# Komprimierung
<IfModule mod_deflate.c>
AddOutputFilterByType DEFLATE text/html text/css application/javascript text/javascript application/json image/svg+xml application/xml text/plain
</IfModule>

# Zwischenspeicher im Browser
<IfModule mod_expires.c>
ExpiresActive On
ExpiresByType image/webp "access plus 6 months"
ExpiresByType image/jpeg "access plus 6 months"
ExpiresByType image/png "access plus 6 months"
ExpiresByType font/woff2 "access plus 1 year"
ExpiresByType text/css "access plus 1 hour"
ExpiresByType application/javascript "access plus 1 hour"
ExpiresByType text/javascript "access plus 1 hour"
ExpiresByType text/html "access plus 10 minutes"
</IfModule>
